# Template — stage 3 installs this with @REPO_DIR@ and @HOST@ substituted.
# Keeps Proton's forwarded port alive and tells qBittorrent about it.
#
# A USER service, not a system one: it talks to qBittorrent's WebUI on
# localhost and needs no privilege at all. natpmpc speaks to the tunnel
# gateway like any other client.
#
# Not tied to graphical-session.target, unlike the playlist export: the port
# has to exist whenever the tunnel does, and qBittorrent may be started or
# restarted at any point. The script waits for the interface by itself and
# says so while it waits, which is more robust than an ordering dependency on
# a NetworkManager connection that can come and go.
#
# Restart=always with a delay, because every reason this can exit is temporary:
# tunnel down, qBittorrent not up yet, a single failed renewal.

[Unit]
Description=phoinix — hold the ProtonVPN forwarded port for qBittorrent
Documentation=file://@REPO_DIR@/scripts/protonvpn-portforward.sh

[Service]
Type=simple
ExecStart=@REPO_DIR@/scripts/protonvpn-portforward.sh @HOST@
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
