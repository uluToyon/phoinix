# Template — stage 3 installs this with @REPO_DIR@ and @HOST@ substituted.
#
# The tunnel, in a namespace of its own. See scripts/vpn-netns.sh for why the
# interface is created outside and moved in, and docs/LOG.md 2026-08-06 for why
# a namespace at all rather than the nftables rule alone.
#
# Type=oneshot with RemainAfterExit: there is no daemon here. The script builds
# a namespace and hands the kernel an interface; both outlive it. Same shape as
# nftables.service, and for the same reason — without RemainAfterExit the unit
# would report inactive while its work stands, and everything that checks it
# would refuse to start.

[Unit]
Description=ProtonVPN tunnel inside a network namespace
Documentation=file:@REPO_DIR@/docs/SETTINGS.md
After=network-online.target
Wants=network-online.target
# NetworkManager must not be holding an interface of the same name. It is not
# ordered After= for a dependency but so the failure mode is readable: the
# script refuses rather than fighting over the name.
After=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@REPO_DIR@/scripts/vpn-netns.sh @HOST@ up
ExecStop=@REPO_DIR@/scripts/vpn-netns.sh @HOST@ down
# A tunnel that failed to come up must not be left half-built: the namespace
# would exist with no route, and anything entering it would sit there silently.
ExecStopPost=-@REPO_DIR@/scripts/vpn-netns.sh @HOST@ down

[Install]
WantedBy=multi-user.target
